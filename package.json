{
  "name": "hse-management",
  "version": "0.1.0",
  "private": true,
  "description": "HSE Management Platform — npm workspaces root",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @hse/api",
    "dev:api": "npm run dev --workspace @hse/api",
    "dev:web": "npm run dev --workspace @hse/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate:local": "npm run db:migrate:local --workspace @hse/api",
    "db:seed:dev": "npm run db:seed:dev --workspace @hse/api",
    "job:run": "npm run job:run --workspace @hse/api"
  }
}
