{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hse-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // 03:00 UTC daily: housekeeping (session tokens, expired registrations).
  // Every 15 minutes: re-publish emails whose queue message was lost (PLT-05 FR-5).
  "triggers": { "crons": ["0 3 * * *", "*/15 * * * *"] },

  // Non-secret configuration. Secrets (JWT_SECRET) go in .dev.vars locally and
  // `wrangler secret put` remotely — never in this file.
  "vars": {
    "APP_ENV": "development",
    "LOG_LEVEL": "debug",
    "CORS_ALLOWED_ORIGINS": "http://localhost:3000",
    "BASE_DOMAIN": "localhost",
    "TRUST_FORWARDED_HOST": "true",
    "TENANT_CACHE_TTL_SECONDS": "300",
    "JWT_ISSUER": "hse-api",
    "JWT_AUDIENCE": "hse-web",
    "JWT_ACCESS_TOKEN_TTL_SECONDS": "900",
    "SESSION_IDLE_TIMEOUT_SECONDS": "28800",
    "SESSION_ABSOLUTE_LIFETIME_SECONDS": "2592000",
    "SESSION_ACTIVITY_WRITE_INTERVAL_SECONDS": "300",
    "REFRESH_REUSE_GRACE_SECONDS": "30",
    "LOGIN_MAX_FAILED_ATTEMPTS": "5",
    "LOGIN_LOCK_DURATION_SECONDS": "900",
    "PASSWORD_HASH_ITERATIONS": "100000",
    "PLATFORM_URL": "http://localhost:3000",
    "EMAIL_PROVIDER": "log",
    "EMAIL_FROM": "HSE Platform <no-reply@localhost>",
    "BOT_CHECK": "turnstile",
    "TRIAL_DAYS": "14",
    "REGISTRATION_VERIFY_TTL_HOURS": "24",
    "REGISTRATION_UNVERIFIED_RETENTION_DAYS": "7",
    "REGISTRATION_RESUBMIT_TTL_DAYS": "30",
    "REGISTRATION_RESEND_LIMIT_PER_HOUR": "3",
    "INVITATION_TTL_DAYS": "7",
    "PASSWORD_RESET_TTL_MINUTES": "60",
    "PASSWORD_RESET_LIMIT_PER_HOUR": "3",
    "GRACE_DAYS": "14",
    "PENDING_PROOF_HOLD_DAYS": "5",
    // Placeholders until the Product Owner supplies the real account (F-09).
    "BILLING_BANK_NAME": "Example Bank (placeholder)",
    "BILLING_BENEFICIARY": "HSE Platform (placeholder)",
    "BILLING_IBAN": "SA00 0000 0000 0000 0000 0000",
  },

  // Bindings. IDs below are local-development placeholders; real IDs are set per
  // environment when resources are provisioned (see infrastructure/cloudflare/README.md).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hse-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "hse-files" }],
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],
  // Per-IP limiter for sign-in and token refresh (T-7). namespace_id is any account-unique number.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "hse-jobs" }],
    // Background jobs (PLT-05: email sending). Retries back off; see platform/jobs.
    "consumers": [
      { "queue": "hse-jobs", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5 },
    ],
  },
}
