# Copy to .env.local for development.
NEXT_PUBLIC_APP_NAME=HSE Management Platform
# Same-origin API path (T-4). Never an absolute URL in the browser.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Development only: where `npm run dev:api` listens. Leave unset in deployed environments.
API_PROXY_ORIGIN=http://127.0.0.1:8787
# Cloudflare Turnstile site key (public). 1x00000000000000000000AA is Cloudflare's always-pass test key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
